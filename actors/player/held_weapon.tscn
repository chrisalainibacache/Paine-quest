[gd_scene format=3]

[ext_resource type="Script" path="res://actors/player/held_weapon.gd" id="1_held"]

[sub_resource type="Shader" id="MuzzleFlashShader"]
code = "shader_type spatial;\nrender_mode unshaded, cull_disabled, blend_add, depth_draw_never;\n\nvoid fragment() {\n    vec2 p = UV * 2.0 - vec2(1.0);\n    float radius = length(p);\n    float angle = atan(p.y, p.x);\n    float rays = 0.5 + 0.5 * cos(angle * 4.0);\n    float edge = 0.32 + 0.58 * pow(rays, 5.0);\n    float alpha = 1.0 - smoothstep(edge - 0.06, edge + 0.03, radius);\n    float core = 1.0 - smoothstep(0.0, 0.75, radius);\n    vec3 orange = vec3(1.0, 0.18, 0.015);\n    vec3 hot = vec3(1.0, 0.88, 0.54);\n    ALBEDO = mix(orange, hot, core);\n    EMISSION = ALBEDO * 3.2;\n    ALPHA = alpha;\n}"

[sub_resource type="ShaderMaterial" id="MuzzleOuter"]
shader = SubResource("MuzzleFlashShader")

[sub_resource type="Shader" id="MuzzleCoreShader"]
code = "shader_type spatial;\nrender_mode unshaded, cull_disabled, blend_add, depth_draw_never;\n\nvoid fragment() {\n    vec2 p = UV * 2.0 - vec2(1.0);\n    float radius = length(p);\n    float alpha = 1.0 - smoothstep(0.48, 1.0, radius);\n    float hot = 1.0 - smoothstep(0.0, 0.82, radius);\n    ALBEDO = mix(vec3(1.0, 0.34, 0.025), vec3(1.0, 0.96, 0.72), hot);\n    EMISSION = ALBEDO * 4.0;\n    ALPHA = alpha;\n}"

[sub_resource type="ShaderMaterial" id="MuzzleCore"]
shader = SubResource("MuzzleCoreShader")

