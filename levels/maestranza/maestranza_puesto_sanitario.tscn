[node name="PazMeeting" type="Node3D" parent="Interactables"]
position = Vector3(0, 0, 1)
script = ExtResource("17_examine_spot")
reach = 1.4
lines = PackedStringArray("Paz: Te escuché por la radio. Pensé que no ibas a llegar.", "Paz: ¿Viste a otros sobrevivientes en el camino?", "Paz: Tengo una credencial de acceso al Centro de Nos. No sé qué vamos a encontrar, pero es la única ruta que sigue abierta. Vamos juntas.")

