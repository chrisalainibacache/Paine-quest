[node name="RadioSocket" type="Node3D" parent="Interactables"]
position = Vector3(1.3, 0, 0.9)
script = ExtResource("21_fuse_box")
puzzle = ExtResource("20_buin_radio_s")
unlock_id = "buin_radio_power"
prompt = "INSTALAR BATERÍA"
missing_text = "La tapa de la radio tiene dos contactos vacíos y una etiqueta: 12 V. Falta la batería."
solved_text = "La batería encaja. El indicador de la radio se enciende, verde y estable."
reach = 1.3

[node name="StorageChest" type="Node3D" parent="Interactables"]
position = Vector3(-2.5, 0.45, -2.5)
script = ExtResource("22_storage_ches")
reach = 1.3

[node name="RosaDoor" type="Node3D" parent="Interactables"]
position = Vector3(2.6, 0, -1)
script = ExtResource("23_voice_door")
reach = 1.3
sets_flag = "talked:rosa"
lines = PackedStringArray("La puerta de la oficina tiene llave. Adentro alguien respira.", "Rosa: ¿Quién está ahí? ...No abras. Por favor, no abras.", "Rosa: Soy Rosa, de la boletería de Paine. Me mordieron en el puente, anoche. Ya tengo el frío del que hablaba don Héctor.", "Rosa: Algo enorme me agarró en el puente. No me terminó de matar... me miró, y se fue. Como si me hubiera dejado guardada.", "Rosa: Escúchame bien, niña. Al hombre de la mano vendada yo le vendí el boleto del 6:30.", "Rosa: Llevaba una credencial colgando: «Centro de Investigación Sanitaria — Nos». Venía de ahí.", "Rosa: Y la radio de los militares... no para de sonar. Es una mujer. Pregunta si hay sobrevivientes.", "Algo no cuadra. Rosa estaba en Paine a las once de la noche. ¿Cómo cruzó sola hasta aquí, con ellos por todos lados?", "Leo: Isabella... no le creas. Ese olor no es de persona, y tampoco es de los otros. Es distinto. Ella no es como los demás.", "Leo: No abras esa puerta. La radio está en la mesa.")
repeat_lines = PackedStringArray("Rosa: Ándate, niña. Llévate al gato. Y escucha esa radio... antes de que yo cambie de idea.")

[node name="Radio" type="Node3D" parent="Interactables"]
position = Vector3(0.6, 0, 0.9)
script = ExtResource("24_chapter_exit")
reach = 1.3
chapter = 3
accept_text = "ESCUCHAR"
required_flags = PackedStringArray("talked:rosa", "unlocked:buin_control_clear", "unlocked:buin_radio_power")
blocked_text = "La radio solo suelta estática. Algo le falta: energía, el paso del control y escuchar antes a quien está en la oficina."
question = "Una radio militar encendida. Entre la estática se oye una voz de mujer.\n¿Escuchar?"
before_lines = PackedStringArray("Paz: ...¿Hay sobrevivientes? Si alguien me escucha... Isabella, si me escuchas... soy yo, Paz.", "Paz: No vayas a Alameda. Allá ya no queda nadie.", "Paz: Me trajeron a la Maestranza de San Bernardo a atender a los enfermos. Llegan en tren, de noche, amarrados.", "Paz: Hay un vagón al fondo que nadie abre. Los militares dicen que es del Centro de Nos...", "Paz: Ven por la vía. Te espero en la entrada de...", "La señal se corta.", "Leo: San Bernardo. Yo sé el camino, Isabella. Vamos.")

