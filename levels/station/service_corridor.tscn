[node name="LeoStoreroom" type="Marker3D" parent="."]
position = Vector3(4.8, 0, 0)
script = ExtResource("35_leo_hint")
lines = PackedStringArray("Leo: Cuidado. No todos los que están en el suelo están muertos.", "Leo: Yo los huelo. Si les bufo, es que se van a levantar. Si no, déjalos dormir.", "Leo: Aparta la barra caída y avanza hacia la BODEGA; si bufo, alguno se levantará.")
hide_if_item = "gate_key"

[node name="LeoLocker04" type="Marker3D" parent="."]
position = Vector3(-1.55, 0, -0.4)
script = ExtResource("35_leo_hint")
lines = PackedStringArray("Leo: Hay una etiqueta cuatro y pintura fresca en ese casillero.", "Leo: La llave huele a chaqueta mojada, no a metal del piso.", "Leo: Registra el casillero 04; busca la llave en el bolsillo interior de la chaqueta.")
hide_if_item = "gate_key"

[node name="LeoBack" type="Marker3D" parent="."]
position = Vector3(-4.8, 0, 0)
script = ExtResource("35_leo_hint")
lines = PackedStringArray("Leo: Ya tienes la llave. Volvamos al andén: el portón sur nos espera.", "Leo: Vuelve por BOLETERÍA, atraviesa la SALA DE ESPERA y regresa al ANDÉN NORTE.")
hide_if_flag = "unlocked:gate_south"
show_if_item = "gate_key"

