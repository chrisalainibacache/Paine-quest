id = "tracks_drain_note"
title = "Nota del encargado del paso"
pages = PackedStringArray("El canal se llena cuando la bomba pierde energía. Si vuelve la corriente, la bomba puede ayudar; la bomba manual y la manguera con abrazadera permiten vaciar primero el registro incluso sin electricidad.")
