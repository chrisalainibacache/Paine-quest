[gd_resource type="Resource" script_class="DocumentData" format=3]

[ext_resource type="Script" path="res://data/documents/document_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = "maestranza_maintenance_report"
title = "Parte de mantenimiento — Galpón de Buin"
pages = PackedStringArray("SÁBADO — 14:40 (hora de recepción del informe)\n\nSe recibió aviso de que el portón del galpón quedó fuera de las bisagras.\nLas astillas están orientadas hacia el patio; el marco cedió hacia afuera.\nEl patrón de rotura apunta desde el interior hacia el patio.\nNo hay marcas de herramienta en el lado exterior.\nNo se pudo determinar quién salió ni cuándo.")
