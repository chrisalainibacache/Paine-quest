script = ExtResource("1_data")
id = "buin_pump_log"
title = "Bitácora de bomba"
pages = PackedStringArray("Sábado, 6:20. La presión no baja si se acciona primero la bomba. Orden de servicio: retorno, canal, bomba. Cuando el manómetro quede estable, registrar la batería de radio del gabinete. — Mantención")
