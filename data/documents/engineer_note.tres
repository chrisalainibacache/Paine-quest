[gd_resource type="Resource" script_class="DocumentData" format=3]

[ext_resource type="Script" path="res://data/documents/document_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = "engineer_note"
title = "Nota del maquinista"
pages = PackedStringArray("Si alguien llega hasta la casa de cambios: no vuelvan al tren.\n\nLos frené contra el desvío para que no llegaran a la ciudad. Fue lo único que se me ocurrió.\n\nPor la vía hacia el norte se llega a Santiago caminando en un día. Vayan de noche no, de día.\n\nYo ya no puedo caminar. Me mordieron en la mano.\n\n— Jorge, maquinista del D-16008")
