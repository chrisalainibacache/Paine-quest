[gd_resource type="Resource" script_class="DocumentData" format=3]

[ext_resource type="Script" path="res://data/documents/document_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = "station_notice"
title = "Aviso de la estación"
pages = PackedStringArray("AVISO A LOS PASAJEROS\n\nPor una emergencia sanitaria en la comuna, los servicios a Santiago quedan suspendidos.\n\nSe ruega no abandonar la estación. Un tren de evacuación pasará a buscarlos esta noche.\n\n— Jefatura de Estación Paine", "(Escrito a mano, abajo del aviso)\n\nSon las once. El tren no va a venir: lo dijeron por la radio, cerraron la línea en Buin.\n\nLa pistola del guardia y sus balas quedaron en la boletería. El portón del andén sur tiene candado; la llave está en la bodega, al fondo del pasillo de servicio.\n\n— Rosa")
