[gd_resource type="Resource" script_class="DocumentData" format=3]

[ext_resource type="Script" path="res://data/documents/document_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = "passenger_ticket"
title = "Boleto con un mensaje"
pages = PackedStringArray("Boleto Paine – Alameda, 6:30. Coche 3, asiento 14.\n\nAtrás, escrito con lápiz:\n\n«El caballero del asiento 15 subió en Paine con la mano vendada. Al rato empezó a toser sangre. Le avisé al conductor y se rió.\n\nAhora ya nadie se ríe.»")
