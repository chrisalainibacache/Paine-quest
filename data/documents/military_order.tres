[gd_resource type="Resource" script_class="DocumentData" format=3]

[ext_resource type="Script" path="res://data/documents/document_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = "military_order"
title = "Orden del día — Control Buin"
pages = PackedStringArray("EJÉRCITO DE CHILE — CONTROL SANITARIO BUIN\nViernes, 21:00.\n\nToda persona que venga de Paine se considera EXPUESTA.\n\nLos mordidos se suben al tren sanitario y se trasladan a la Maestranza de San Bernardo. No se informa a la población del destino.", "A la población se le dice: «tren de evacuación».\n\nSi un trasladado se vuelve agresivo durante el viaje, el personal está autorizado a cerrar el vagón.\n\n— Capitán R. Soto")
