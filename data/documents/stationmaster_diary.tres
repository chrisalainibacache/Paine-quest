[ext_resource type="Script" path="res://data/documents/document_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = "stationmaster_diary"
title = "Diario del jefe de estación"
pages = PackedStringArray("Viernes, 13:00.\n\nEl 6:30 quedó volcado en el desvío, antes de Linderos. Jorge, el maquinista, lo metió ahí a propósito: había mordidos en el coche 3.\n\nLos que alcanzaron a bajar volvieron caminando por la vía. Llegaron mordidos. Al rato ya no eran ellos.", "Don Héctor se levantó. No fui capaz de dispararle: lo dejé encerrado aquí, en la bodega.\n\nCerré el portón del andén sur con candado para que no entren más desde la vía. La llave queda en esta mesa.\n\nSi alguien quiere llegar a Santiago, la única forma es caminar por la vía hacia el norte. Que Dios los acompañe.\n\n— Raúl, jefe de estación")
