script = ExtResource("1_data")
id = "buin_harvest_manifest"
title = "Manifiesto de cosecha"
pages = PackedStringArray("VIÑA SANTA ROSA — Carga de vendimia. El carro debe quedar sobre la marca doble para liberar el portón de retorno. Las cajas del fondo se registran después de despejar la plataforma. No bloquear el paso al galpón.")
