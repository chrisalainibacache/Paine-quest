script = ExtResource("1_data")
id = "maestranza_radio_transcript"
title = "Transcripción de radio — Canal sanitario"
pages = PackedStringArray("SÁBADO — 15:20\n\nPaz: ¿Hay sobrevivientes en el sector norte? Repito: ¿hay sobrevivientes?\nNo respondan si no están en un lugar seguro.\nNecesito saber cuántos pueden caminar y cuántos necesitan ayuda.\nLa señal se corta antes de que llegue una respuesta.")
