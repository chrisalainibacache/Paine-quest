[gd_resource type="Resource" script_class="DocumentData" format=3]

[ext_resource type="Script" path="res://data/documents/document_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = "maestranza_nursing_log"
title = "Registro de enfermería — Turno anterior"
pages = PackedStringArray("SÁBADO — 14:10 (copia de un registro del turno anterior)\n\nEn el turno anterior, una mujer se detuvo frente a la reja.\nNo parpadeó; tarareaba una melodía que no reconocí.\nLos perros se echaron al suelo y dejaron de ladrar.\nLa gata de la sala siguió junto a la puerta.")
