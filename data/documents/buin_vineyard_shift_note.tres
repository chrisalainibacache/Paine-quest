[resource]
script = ExtResource("1_data")
id = "buin_vineyard_shift_note"
title = "Nota del turno de viña"
pages = PackedStringArray("Sábado, 6:35. El pestillo de retorno se traba desde el lado del galpón. La barra solo se alcanza desde la pasarela de mantenimiento. La llave del galpón está en la bodega, dentro del compartimento del tractor.")
