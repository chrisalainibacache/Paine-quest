[gd_resource type="Resource" script_class="DocumentData" format=3]

[ext_resource type="Script" path="res://data/documents/document_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = "maestranza_closure_order"
title = "Orden de cierre — Vagón del Centro de Nos"
pages = PackedStringArray("SÁBADO — 15:48\n\nPrecinto de puerta: intacto.\nOrden escrita: NO ABRIR. No se autoriza inspección del interior.\nLa revisión exterior no registra golpes recientes ni daños en el sello.\nNo se adjuntó autorización de apertura.")
