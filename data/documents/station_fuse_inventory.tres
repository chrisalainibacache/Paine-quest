[resource]
script = ExtResource("1_data")
id = "station_fuse_inventory"
title = "Inventario de fusibles"
pages = PackedStringArray("Tablero de señales: dos fusibles de 10 A. Uno se retiró para revisar la humedad de los baños. El repuesto quedó guardado en el cajón inferior de esta oficina. No instalar piezas de otro amperaje.\n\n— Mantenimiento")
