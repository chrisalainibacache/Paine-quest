script = ExtResource("1_data")
id = "buin_irrigation_plan"
title = "Plano del riego"
pages = PackedStringArray("CANAL DE RIEGO — El registro bajo queda junto a la compuerta norte. Para vaciarlo, conecte manguera y abrazadera antes de abrir el desagüe. La pasarela alta conduce a la caseta de bombas. — Mantención")
