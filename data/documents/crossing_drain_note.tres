[resource]
script = ExtResource("1_data")
id = "crossing_drain_note"
title = "Nota del encargado del paso"
pages = PackedStringArray("El canal se llena cuando la bomba pierde energía. Si vuelve la corriente, no arranque la bomba con el canal lleno. Use manguera y abrazadera; vacíe primero el registro.")
