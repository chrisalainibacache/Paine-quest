script = ExtResource("1_data")
id = "tracks_fuel_report"
title = "Parte de mantenimiento"
pages = PackedStringArray("6:46. Después del impacto, la línea de combustible quedó abierta. El fuego alcanzó el lateral de la locomotora; la llave de corte sigue accesible. Cierren las válvulas según la placa, sin mover la locomotora. — J. Muñoz")
