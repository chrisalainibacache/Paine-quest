[gd_resource type="Resource" script_class="DocumentData" format=3]

[ext_resource type="Script" path="res://data/documents/document_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = "maestranza_patient_statement"
title = "Declaración de paciente — Camilla 4"
pages = PackedStringArray("SÁBADO — 14:25\n\nPor la vía de servicio camina una señora cuando cae la tarde.\nNo corre. Los infectados se apartan antes de que llegue a la reja.\nYo me quedé quieto hasta que dejó de tararear.\nNo pienso volver a pasar por ese pasillo.")
