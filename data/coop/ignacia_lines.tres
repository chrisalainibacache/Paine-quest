[gd_resource type="Resource" script_class="CoopLines" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/coop_lines.gd" id="1_lines"]

[resource]
script = ExtResource("1_lines")
entries = Array[Dictionary]([
{ "room": "station/platform", "event": "coop_intro", "text": "Ignacia: ¡Oye, oye, tranquila! Estoy viva. Estoy bien viva." },
{ "room": "station/platform", "event": "coop_intro", "text": "Ignacia: ¿Eres Isabella? ¿La hermana de Paz? Tienes los mismos ojos de la foto." },
{ "room": "station/platform", "event": "coop_intro", "text": "Ignacia: Soy Ignacia, trabajo con tu hermana. Me pidió que viniera a buscarte. Era un viaje de cuarenta minutos." },
{ "room": "station/platform", "event": "coop_intro", "text": "Ignacia: Dejé el auto en la entrada. Había gente… gente que no estaba bien. Corrí." },
{ "room": "station/platform", "event": "coop_intro", "text": "Isabella: ¿Paz está bien?" },
{ "room": "station/platform", "event": "coop_intro", "text": "Ignacia: Estaba bien cuando salí. Después no pude llamarla." },
{ "room": "station/platform", "event": "coop_intro", "text": "Ignacia: El Ejército no deja pasar a nadie hacia el norte. Por carretera, no. Pero la vía sigue ahí." },
{ "room": "station/platform", "event": "coop_intro", "text": "Ignacia: ¿Y esa gata? Qué linda. Y qué tranquila, con todo esto." },
{ "room": "station/platform", "event": "coop_intro", "text": "Isabella asiente. Habla poco." },
{ "room": "station/platform", "event": "note_arrugada", "text": "Ignacia: «No se acerquen a él». Mejor le hacemos caso." },
{ "room": "station/waiting_room", "event": "typewriter", "text": "Ignacia: ¿Una máquina de escribir? Bueno… guardar es guardar." },
{ "room": "station/ticket_office", "event": "pistol", "text": "Ignacia: Yo con eso me disparo en un pie. La llevas tú." },
{ "room": "station/service_corridor", "event": "fake_dead", "text": "Ignacia: Ese de allá se hace el muerto. Le vi mover un dedo." },
{ "room": "station/service_corridor", "event": "leo_buffs", "text": "Ignacia: Tu gata y yo pensamos igual." },
{ "room": "station/storeroom", "event": "don_hector", "text": "Ignacia: Pobre hombre… Cuando todo esto pase, alguien tiene que avisarle a su familia." },
{ "room": "station/south_platform", "event": "chapter_exit", "text": "Ignacia: Entonces es por la vía. Vamos." },
{ "room": "tracks/track_north", "event": "first_leo_hint", "text": "Isabella: Por allá." },
{ "room": "tracks/track_north", "event": "first_leo_hint", "text": "Ignacia: ¿Y tú cómo sabes?" },
{ "room": "tracks/track_north", "event": "first_leo_hint", "text": "Isabella: Leo." },
{ "room": "tracks/track_north", "event": "first_leo_hint", "text": "Ignacia: Tu gata es mejor que un GPS." },
{ "room": "tracks/track_north", "event": "chapter_entry", "text": "Ignacia: Humo. Mucho humo. Eso no es una fogata." },
{ "room": "tracks/wagon_interior", "event": "cross_wagon", "text": "Ignacia: Cruzar por dentro. Claro. Siempre es por dentro." },
{ "room": "tracks/underpass", "event": "blackout", "text": "Ignacia: Tengo una frontal. Tú la tuya, yo la mía. No nos separemos." },
{ "room": "tracks/switch_house", "event": "read_engineer_note", "text": "Ignacia: Jorge se quedó para que otros pasaran… Eso no lo hace cualquiera." },
{ "room": "tracks/switch_house", "event": "safe_room", "text": "Ignacia: Descansa un rato. Yo hago guardia. En el hospital aprendí a dormir sentada." },
{ "room": "buin/bridge", "event": "chapter_entry", "text": "Ignacia: Anoche pasé por este puente en auto. No había nada de esto." },
{ "room": "buin/checkpoint", "event": "chapter_entry", "text": "Ignacia: Por aquí me dejaron pasar sin preguntar nada. Hacia el sur, todo bien. Hacia el norte, no." },
{ "room": "buin/galpon", "event": "rosa_reveal", "text": "Ignacia: Isabella, yo crucé ese puente a las once y media y no había nadie. ¿Cómo cruzó ella?" },
{ "room": "buin/galpon", "event": "rosa_reveal", "text": "Isabella: Leo dice que no le creamos." },
{ "room": "buin/galpon", "event": "rosa_end", "text": "Ignacia: No me gusta cómo respira." },
{ "room": "buin/galpon", "event": "radio_paz", "text": "Ignacia: ¡Es ella! ¡Es Paz!" },
{ "room": "buin/galpon", "event": "radio_paz", "text": "Paz: …Si Ignacia está con ella, por favor, no la sueltes." },
{ "room": "maestranza/access", "event": "side_door", "text": "Ignacia: Una puerta lateral. Tu gata ya la encontró." },
{ "room": "maestranza/infirmary", "event": "testimonies", "text": "Ignacia: Esto es una enfermería de verdad… y no hay un solo paciente vivo." },
{ "room": "maestranza/wardrobe", "event": "humming", "text": "Ignacia: ¿Tú también oyes eso? Alguien… tarareando." },
{ "room": "maestranza/quarantine", "event": "sealed_car", "text": "Ignacia: Precinto intacto. Eso no se toca." },
{ "room": "maestranza/medical_post", "event": "reunion", "text": "Paz: ¡Ignacia! ¡Isabella!" },
{ "room": "maestranza/medical_post", "event": "reunion", "text": "Paz: Ignacia… te mandé a buscarla y volviste con ella. Gracias." },
{ "room": "maestranza/medical_post", "event": "chapter_end", "text": "Isabella, Ignacia, Paz y Leo." },
{ "room": "santiago/center_nos", "event": "clinical_records", "text": "Ignacia: Esto no es un paciente: es un seguimiento." },
{ "room": "santiago/final", "event": "skull_voice", "text": "Ignacia: Isabella… esa es la voz de la señora del galpón." },
{ "room": "epilogue", "event": "para_leo", "text": "Isabella mueve la cabeza con suavidad; Ignacia calla y le pone una mano en el hombro." },
{ "room": "any", "event": "leo_hint_translation", "text": "Isabella repite en una frase corta lo que Leo le acaba de indicar." },
{ "room": "buin/galpon", "event": "leo_hint_rosa", "text": "Isabella: Leo dice que no le creamos." },
{ "room": "buin/galpon", "event": "leo_hint_rosa", "text": "Ignacia: ¿Leo dice?… Está bien. Yo también tengo un mal presentimiento." }
])
